      "costs": [ { "mode": "Percent", "stat": "AtkSpeed", "add": 10 } ] },
    { "id": "good_wateringcan", "name": "铜洒水壶", "grade": "C", "category": 2, "price": 30, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：主城杂货店的铜壶搬进战斗——壶口更稳，水线更直，但也压手。数值：远程伤害 +1 点（水壶一道 6 点 ⇒ 7 点），代价是攻击速度 −3%（出手间隔变成 1.031 倍）。限制：只加水壶这条线；锄头与肥料一点不变。",
