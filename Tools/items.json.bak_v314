    { "id": "gamble_glove", "name": "赌命手套", "grade": "S", "category": 3, "price": 80, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：手腕沉了一点、脚步也慢了一点，可一出手就是更狠的重击。数值：暴击率 +9.9 个百分点（5% ⇒ 14.9%）、暴击伤害 +99%（×1.5 ⇒ ×2.985，即 298.5%）；代价是**移速 −9.9%**（5.5 米/秒 ⇒ 4.96 米/秒）与**攻速 −9.9%**（攻速 1.0 ⇒ 0.901，锄头出手间隔 ×1.110，即慢 11%）。限制：这是**代价换收益**的一件，两半同时生效、不能只要其中一半；多买会线性叠加（2 件 = 暴击率 24.8%、暴击伤害 ×4.47、移速与攻速各 −19.8%），件数越多走得越慢、挥得越慢，但暴击那两半也一起叠加；它不动攻击范围、不动伤害倍率。",
      "effects": [
        { "mode": "Percent", "stat": "MoveSpeed", "add": -9.9 },
        { "mode": "Percent", "stat": "AtkSpeed", "add": -9.9 },
        { "mode": "Add", "stat": "CritRate", "add": 0.099 },
        { "mode": "Percent", "stat": "CritDmg", "add": 99 }
      ],
      "rule": "crit_trade", "ruleValue": 0 },

    { "id": "sharp_spray", "name": "锋利水枪", "grade": "S", "category": 3, "price": 80, "maxStack": 1,
      "desc": "触发：喷水扫过作物时。效果：水柱改走刃口，扫过熟透的作物就算收了，不用再走过去割。数值：只要水柱碰到「已成熟」的格子，那一格立刻收获（金币/经验照常按格结算）；代价是远程伤害 −5 点（水壶 6 ⇒ 1）。限制：持有上限 1 件；只收成熟格，成长中的作物碰了不算。",
      "costs": [ { "mode": "Add", "stat": "RangedDamage", "add": 5 } ],
      "rule": "sharp_water" },

    { "id": "tycoon_coin", "name": "富豪钱袋", "grade": "S", "category": 3, "price": 80, "maxStack": 9999,
      "desc": "触发：每次攻击结算时。效果：钱越多，砸出去的那一下越重。数值：额外伤害 = 取整(金币 × 1%)，**最多 29.9 点**（金币 25 ⇒ 0 点；150 ⇒ 2 点；2000 ⇒ 20 点；3000 ⇒ 也封在 29.9 点）；这件本身还给幸运 +30 个百分点（5% ⇒ 35%）；代价是伤害倍率 −20%（×1.00 ⇒ ×0.80）。限制：额外伤害是**加法**、且有 29.9 的上限，不会随金币指数放大。",
      "effects": [ { "mode": "Add", "stat": "Luck", "add": 0.3 } ],
      "costs": [ { "mode": "Percent", "stat": "AtkMult", "add": 20 } ],
      "rule": "gold_damage", "ruleValue": 1 },






