      "effects": [ { "mode": "Percent", "stat": "AtkMult", "add": 6 } ] },

    { "id": "wind_bell", "name": "风铃", "grade": "D", "category": 1, "price": 20, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：风一响，手就快半拍。数值：攻击速度 +5%（开局攻速 1.0 ⇒ 1.05，出手间隔变成原来的 0.95 倍）。限制：三把武器一起变快；不改变伤害。",
      "effects": [ { "mode": "Percent", "stat": "AtkSpeed", "add": 5 } ] },

    { "id": "long_handle", "name": "长柄", "grade": "D", "category": 1, "price": 20, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：柄加长了，够得到更远的那一只。数值：攻击范围 +6%（开局锄头 3.42 米 ⇒ 3.63 米，水壶 9.5 米 ⇒ 10.07 米）。限制：只加长度，不加宽度与判定夹角。",
      "effects": [ { "mode": "Percent", "stat": "AtkRange", "add": 6 } ] },

    { "id": "lucky_bead", "name": "幸运珠", "grade": "C", "category": 1, "price": 30, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：握在手里的好彩头，下手更容易落到要害。数值：暴击率 +4 个百分点（开局 5% ⇒ 9%）。限制：暴击率是概率，不保证每一下都暴击；暴击时伤害 ×1.5（暴击伤害 150%）。",
