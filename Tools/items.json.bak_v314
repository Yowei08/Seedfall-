    { "id": "grind_stone", "name": "磨石", "grade": "C", "category": 1, "price": 30, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：磨出更细的刃线，落在要害上更疼。数值：暴击伤害 +15%（开局 ×1.5 ⇒ ×1.725；锄头暴击一刀 13.8 点）。限制：只在**暴击那一下**生效；不暴击时一点不加。",
      "effects": [ { "mode": "Percent", "stat": "CritDmg", "add": 15 } ] },

    { "id": "blast_grain", "name": "爆裂粒", "grade": "C", "category": 1, "price": 30, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：混进肥料的爆粒，炸开时火更旺。数值：爆炸伤害 +2 点（开局一炸 12 点 ⇒ 14 点）。限制：只加肥料；不加大爆炸半径，也不加火药充能。",
      "effects": [ { "mode": "Add", "stat": "BlastDamage", "add": 2 } ] },

    { "id": "wide_funnel", "name": "广口漏斗", "grade": "C", "category": 1, "price": 30, "maxStack": 9999,
      "desc": "触发：购买后一直生效。效果：口子开得更大，炸开的圈也更宽。数值：爆炸范围 +15%（开局主爆半径 3 米 ⇒ 3.45 米；覆盖面积约 ×1.32）。限制：只加半径；不提高爆炸伤害。",
